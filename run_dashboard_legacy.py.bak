# ─────────────────────────────────────────────────────────────
# ROUTES
# ─────────────────────────────────────────────────────────────

@app.route('/')
def index():
    """Main dashboard view."""
    
    # Get filters from query params
    session_filter = request.args.get('session', 'all')
    status_filter = request.args.get('status', 'all')
    min_score = int(request.args.get('min_score', 0))
    sort_by = request.args.get('sort', 'score_desc')
    
    # Get stats
    stats = get_database_stats()
    sessions = get_all_sessions()
    
    # Get companies
    companies = []
    with get_db_connection() as conn:
        cursor = conn.cursor()
        
        query = "SELECT * FROM companies WHERE 1=1"
        params = []
        
        # Session filter
        if session_filter != 'all':
            query += " AND session_id = ?"
            params.append(int(session_filter))
        
        # Status filter
        if status_filter != 'all':
            query += " AND status = ?"
            params.append(status_filter)
        
        # Score filter
        if min_score > 0:
            query += " AND score >= ?"
            params.append(min_score)
        
        # Sorting
        if sort_by == 'score_desc':
            query += " ORDER BY score DESC NULLS LAST"
        elif sort_by == 'score_asc':
            query += " ORDER BY score ASC NULLS LAST"
        elif sort_by == 'name_asc':
            query += " ORDER BY name ASC"
        elif sort_by == 'name_desc':
            query += " ORDER BY name DESC"
        elif sort_by == 'session_desc':
            query += " ORDER BY session_id DESC"
        elif sort_by == 'session_asc':
            query += " ORDER BY session_id ASC"
        
        cursor.execute(query, params)
        
        for row in cursor.fetchall():
            company = dict(row)
            
            # Extract location and info from raw_data_json
            if company.get('raw_data_json'):
                try:
                    raw = json.loads(company['raw_data_json'])
                    company['location'] = raw.get('location', raw.get('headquarters', ''))
                    company['info'] = raw.get('info', raw.get('description', ''))[:100]
                except:
                    company['location'] = ''
                    company['info'] = ''
            else:
                company['location'] = ''
                company['info'] = ''
            
            companies.append(company)
    
    return render_template_string(
        HTML_TEMPLATE,
        stats=stats,
        sessions=sessions,
        companies=companies,
        session_filter=session_filter,
        status_filter=status_filter,
        min_score=min_score,
        sort_by=sort_by
    )


@app.route('/delete/<int:company_id>')
def delete_company(company_id):
    """Delete a single company."""
    with get_db_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("DELETE FROM companies WHERE id = ?", (company_id,))
    
    return redirect(url_for('index'))


@app.route('/clear-confirm')
def clear_confirm():
    """Show confirmation page for clearing database."""
    return render_template_string(CONFIRM_TEMPLATE)


@app.route('/clear')
def clear_database():
    """Clear all data from the database."""
    with get_db_connection() as conn:
        cursor = conn.cursor()
        # Drop all tables safely
        cursor.execute("DROP TABLE IF EXISTS companies")
        cursor.execute("DROP TABLE IF EXISTS sessions")
        cursor.execute("DROP TABLE IF EXISTS checkpoints")
        cursor.execute("DROP TABLE IF EXISTS scraped_urls")
    
    # Reinitialize database with fresh tables
    init_database()
    
    return redirect(url_for('index'))


@app.route('/deduplicate')
def deduplicate():
    """Remove duplicate companies based on fuzzy name matching."""
    from data.db import normalize_company_name, is_similar_company
    
    session_filter = request.args.get('session', 'all')
    
    with get_db_connection() as conn:
        cursor = conn.cursor()
        
        # Build query for companies to check
        if session_filter != 'all':
            cursor.execute("""
                SELECT id, name, score, status, session_id FROM companies 
                WHERE session_id = ? ORDER BY score DESC NULLS LAST, id ASC
            """, (int(session_filter),))
        else:
            cursor.execute("""
                SELECT id, name, score, status, session_id FROM companies 
                ORDER BY score DESC NULLS LAST, id ASC
            """)
        
        all_companies = cursor.fetchall()
        
        # Group by session for per-session deduplication
        sessions = {}
        for c in all_companies:
            sid = c['session_id']
            if sid not in sessions:
                sessions[sid] = []
            sessions[sid].append(dict(c))
        
        ids_to_delete = []
        
        for session_id, companies in sessions.items():
            seen_normalized = {}  # normalized_name -> best company (highest score)
            
            for c in companies:
                norm = normalize_company_name(c['name'])
                
                # Check if we have a similar one already
                found_similar = None
                for seen_norm in seen_normalized:
                    if is_similar_company(c['name'], seen_normalized[seen_norm]['name']):
                        found_similar = seen_norm
                        break
                
                if found_similar:
                    # Duplicate found - keep the one with higher score or enriched status
                    existing = seen_normalized[found_similar]
                    existing_score = existing.get('score') or 0
                    new_score = c.get('score') or 0
                    
                    # Prefer enriched over discovered, then higher score
                    if c['status'] == 'enriched' and existing['status'] != 'enriched':
                        ids_to_delete.append(existing['id'])
                        seen_normalized[norm] = c
                    elif existing['status'] == 'enriched' and c['status'] != 'enriched':
                        ids_to_delete.append(c['id'])
                    elif new_score > existing_score:
                        ids_to_delete.append(existing['id'])
                        seen_normalized[norm] = c
                    else:
                        ids_to_delete.append(c['id'])
                else:
                    seen_normalized[norm] = c
        
        # Delete duplicates
        deleted_count = 0
        for cid in ids_to_delete:
            cursor.execute("DELETE FROM companies WHERE id = ?", (cid,))
            deleted_count += 1
    
    # Flash message or redirect with count
    return redirect(url_for('index', dedup_count=deleted_count))


@app.route('/export')
def export_csv():
    """Export companies to CSV with current filters applied."""
    
    # Get filter params from query string
    session_filter = request.args.get('session', 'all')
    status_filter = request.args.get('status', 'all')
    min_score = int(request.args.get('min_score', 0))
    
    with get_db_connection() as conn:
        cursor = conn.cursor()
        
        # Build query with filters
        query = "SELECT c.name, c.website, c.score, c.status, c.session_id, c.raw_data_json FROM companies c WHERE 1=1"
        params = []
        
        # Session filter
        if session_filter != 'all':
            query += " AND c.session_id = ?"
            params.append(int(session_filter))
        
        # Status filter
        if status_filter != 'all':
            query += " AND c.status = ?"
            params.append(status_filter)
        
        # Score filter
        if min_score > 0:
            query += " AND c.score >= ?"
            params.append(min_score)
        
        query += " ORDER BY c.score DESC NULLS LAST"
        
        cursor.execute(query, params)
        rows = cursor.fetchall()
    
    # Build CSV
    csv_lines = ["Name,Website,Score,Status,Session,Location,Info"]
    
    for row in rows:
        name = row['name'].replace(',', ' ')
        website = row['website'] or ''
        score = row['score'] or ''
        status = row['status']
        session = row['session_id']
        
        location = ''
        info = ''
        if row['raw_data_json']:
            try:
                raw = json.loads(row['raw_data_json'])
                location = raw.get('location', '').replace(',', ' ')
                info = raw.get('info', '')[:50].replace(',', ' ').replace('\n', ' ')
            except:
                pass
        
        csv_lines.append(f"{name},{website},{score},{status},{session},{location},{info}")
    
    csv_content = '\n'.join(csv_lines)
    
    # Dynamic filename based on filters
    filename = "portin_companies"
    if session_filter != 'all':
        filename += f"_session{session_filter}"
    if status_filter != 'all':
        filename += f"_{status_filter}"
    filename += ".csv"
    
    return Response(
        csv_content,
        mimetype='text/csv',
        headers={'Content-Disposition': f'attachment; filename={filename}'}
    )


