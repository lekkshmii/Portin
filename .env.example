# ═══════════════════════════════════════════════════════════════════
# PORTIN - Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# 
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────

# Gemini API Key (REQUIRED)
# Get free key: https://aistudio.google.com/app/apikey
# Free tier: 1,500 requests/day
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────────
# RECOMMENDED (for better search results)
# ─────────────────────────────────────────────────────────────────────

# Serper API Key (Google Search)
# Get free key: https://serper.dev
# Free tier: 2,500 searches/month
SERPER_KEY=your_serper_api_key_here

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL (backup/alternative services)
# ─────────────────────────────────────────────────────────────────────

# Firecrawl API Key (Web Scraping)
# Get free key: https://firecrawl.dev
# Free tier: 500 credits
FIRECRAWL_KEY=your_firecrawl_api_key_here

# UK Companies House API Key
# Get free key: https://developer.company-information.service.gov.uk/
# Free tier: 600 requests/5 minutes
COMPANIES_HOUSE_API_KEY=your_companies_house_key_here

# OpenCorporates API Key (Optional - free tier available without key)
# https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# NOTES
# ─────────────────────────────────────────────────────────────────────
#
# - Only GEMINI_API_KEY is strictly required
# - Without SERPER_KEY, discovery will use DuckDuckGo (free, no key)
# - Without FIRECRAWL_KEY, enrichment will use Crawl4AI (free, local)
# - SEC EDGAR API requires no key (free public access)
#
